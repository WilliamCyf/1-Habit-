{
  "name": "repling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Repling — a camera-verified home workout coach with a pet and garden. iPhone PWA.",
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "predev": "npm run copy-wasm",
